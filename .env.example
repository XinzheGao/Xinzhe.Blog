# Official Notion internal connection token; keep real values in .env.local.
NOTION_API_TOKEN=
# Existing blog database ID; no need to change an existing valid value.
NOTION_PAGE_ID=
# Optional: only needed if the database contains multiple data sources.
NOTION_DATA_SOURCE_ID=
# Optional refresh interval in seconds (1–300); defaults to 60.
NOTION_REVALIDATE_SECONDS=60

# Public comments connection. These values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
