# Notion 官方连接令牌；真实值仅放在服务器或被忽略的 .env.local 中。
NOTION_API_TOKEN=
# 博客数据库 ID；优先读取新变量，也兼容已有的 NOTION_PAGE_ID。
NOTION_DATABASE_ID=
# 可选：数据库有多个数据源时明确指定。
NOTION_DATA_SOURCE_ID=
# 缓存及 ISR 间隔，范围 1～300 秒，默认 60 秒。
NOTION_REVALIDATE_SECONDS=60

# 可选：联系表单 Telegram 转发，Token 必需；Chat ID 留空时使用原默认值。
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 可选：评论连接，以下值会公开给浏览器。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
